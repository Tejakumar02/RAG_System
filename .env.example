# .env — Copy this to rag_system/.env and adjust as needed

# LLM
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=mistral #(I used "mistral" but you can choose any Ollama model you have)
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=240

# Embedding
EMBEDDING_MODEL=all-MiniLM-L6-v2 # (you can change this to any compatible sentence-transformers model)
EMBEDDING_DEVICE=cpu   # or "cuda" if you have a GPU

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=80
MIN_CHUNK_SIZE=50

# Retrieval
TOP_K=5
SIMILARITY_THRESHOLD=0.25

# API
API_HOST=0.0.0.0
API_PORT=8000
MAX_FILE_SIZE_MB=50